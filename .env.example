# Copy to .env for local runs (never commit real secrets).
# SSO_SECRET is set automatically on deploy from panenka AUTH_SECRET.

# Top-4 Telegram ping bot (/pihajme). On production, prefer /opt/din8sty/.env.bot
# so deploy.sh can append it without wiping SSO_SECRET.
TOP4_PING_BOT_TOKEN=
# TELEGRAM_PIHAJME_TOKEN=   # alias accepted by the bot
# Forum topic for structured draft pick logs (not turn pings).
# https://t.me/c/2419087266/3 → chat_id + message_thread_id
TOP4_PICK_LOG_CHAT_ID=-1002419087266
TOP4_PICK_LOG_THREAD_ID=3

# H2H draft assistant (same bot process). Must match panenka H2H_BOT_SECRET.
H2H_BOT_SECRET=
# H2H_BOT_API_ORIGIN=https://panenka.games
